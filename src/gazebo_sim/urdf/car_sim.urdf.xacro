<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" 
       xmlns:ignition="http://ignitionrobotics.org/schema" 
       name="my_mecanum_car">

  <xacro:include filename="$(find gazebo_sim)/urdf/robot_model_sim.urdf" />

  <link name="sim_base_footprint">
    <inertial>
      <mass value="0.0"/> 
      <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
    </inertial>
  </link>

  <joint name="sim_footprint_joint" type="fixed">
    <parent link="sim_base_footprint"/>
    <child link="base_footprint"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <gazebo>
    <plugin
      filename="libignition-gazebo-mecanum-drive-system.so"
      name="ignition::gazebo::systems::MecanumDrive">
      
      <front_left_joint>front_left_jt</front_left_joint>
      <front_right_joint>front_right_jt</front_right_joint>
      <back_left_joint>back_left_jt</back_left_joint>
      <back_right_joint>back_right_jt</back_right_joint>

      <wheel_separation>0.383</wheel_separation>
      <wheelbase>0.41</wheelbase>
      <wheel_radius>0.05</wheel_radius>
      
      <max_linear_acceleration>10.0</max_linear_acceleration>
      <max_angular_acceleration>10.0</max_angular_acceleration>
      
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin 
      filename="libignition-gazebo-joint-state-publisher-system.so"
      name="ignition::gazebo::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <joint_name>front_left_jt</joint_name>
      <joint_name>front_right_jt</joint_name>
      <joint_name>back_left_jt</joint_name>
      <joint_name>back_right_jt</joint_name>
    </plugin>
  </gazebo>

  <gazebo reference="front_left">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2> <fdir1>1 -1 0</fdir1>
  </gazebo>
  <gazebo reference="front_right">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2> <fdir1>1 1 0</fdir1>
  </gazebo>
  <gazebo reference="back_left">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2> <fdir1>1 1 0</fdir1>
  </gazebo>
  <gazebo reference="back_right">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2> <fdir1>1 -1 0</fdir1>
  </gazebo>

</robot>